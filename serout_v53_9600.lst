; SEROUT v53 9600 - listing (adresy wzgledem SO = RAM+&1C5), 84 bajtow
;
                 ; =====================================================================
                 ; SEROUT v53 - programowy nadajnik UART 9600 bps 8N1 dla Sharp PC-1500(A)
                 ; CPU LH5801 @ 1,3 MHz, wyjscie PC7 (&F008 bit 7), polaryzacja TTL
                 ; (spoczynek = 1, bit startu = 0).
                 ;
                 ; Wywolanie z BASIC-a:
                 ;   CALL SO          wyslij 1 znak z TX+0
                 ;   CALL SO,N        wyslij N znakow z TX+0.. (0 = 1 znak, >128 = 128)
                 ; Zmienna N NIE jest zmieniana (powrot z C=0).
                 ;
                 ; 1 bit = 1/9600 s = 135,4 cyklu. Czasy (cykle, tablica MAME / instrukcja):
                 ;   bit danych 134 / 137, bit startu 134-135 / 137-138, bit stopu ~1,2 bitu.
                 ; Obie galezie (bit 0 i bit 1) maja te sama dlugosc, a zapis do portu
                 ; nastepuje w nich w tym samym momencie (+-1 cykl).
                 ; Licznik bitow: znacznik (sentinel) - SEC+ROR wklada 1 do bitu 7, po
                 ; osmym SHR akumulator = 0. Z sprawdzamy przez BII A,&FF, bo wedlug
                 ; instrukcji LH5801 rozkazy SHR/ROR nie ustawiaja flagi Z.
                 ; Licznik znakow w UH, bez zmiennych w pamieci.
                 ;
                 ; Adres ladowania: SO = RAM+&1C5 (&41C5), 84 bajty (&41C5..&4218).
                 ; Symbole wstawiane przez BASIC: TH/TL = adres bufora TX.
                 ; =====================================================================
00  FD BE                RIE                 ; bez przerwan (timing!)
02  84                   LDA  XH             ; CALL SO bez zmiennej: X = adres w ROM (XH<>0)
03  89 0B                BZR+ N1             ;   -> 1 znak
05  04                   LDA  XL
06  8B 08                BZS+ N1             ; N = 0 -> 1 znak
08  BF 80                BII  A,&80
0A  8B 06                BZS+ NOK            ; N = 1..127
0C  B5 80                LDI  A,&80          ; N >= 128 -> 128 (caly bufor TX)
0E  8E 02                BCH+ NOK
10  B5 01        N1:     LDI  A,1
12  28           NOK:    STA  UH             ; UH = liczba znakow do wyslania
13  48 TH                LDI  XH,TH          ; X = bufor TX
15  4A TL                LDI  XL,TL
17  58 F0                LDI  YH,&F0         ; Y = &F008 (port C)
19  5A 08                LDI  YL,&08
1B  FD 5B 80             ORI  #(Y),&80       ; PC7 = 1 (spoczynek) ...
1E  6A 0C                LDI  UL,12          ; ... przez ~1 bit przed pierwszym startem
20  88 02        IDLE:   LOP  UL,IDLE
22  45           CHAR:   LIN  X              ; A = znak, X++
23  FD 59 7F             ANI  #(Y),&7F       ; bit startu (PC7 = 0)
26  FB                   SEC
27  D1                   ROR                 ; C = bit 0, znacznik 1 -> bit 7 A
28  6A 07                LDI  UL,7           ; dlugosc bitu startu
2A  88 02        SDLY:   LOP  UL,SDLY
2C  38                   NOP
2D  83 06        OUT:    BCS+ ONE            ; wyslij bit z C
2F  F9                   REC                 ; (wyrownanie: zapis w tym samym cyklu)
30  FD 59 7F             ANI  #(Y),&7F       ; PC7 = 0
33  8E 05                BCH+ BDLY
35  FD 5B 80     ONE:    ORI  #(Y),&80       ; PC7 = 1
38  38                   NOP                 ; (wyrownanie dlugosci galezi)
39  FB                   SEC
3A  6A 05        BDLY:   LDI  UL,5           ; dlugosc bitu danych
3C  88 02        DLY:    LOP  UL,DLY
3E  F9                   REC                 ; (dostrojenie: +4 cykle)
3F  D5                   SHR                 ; C = nastepny bit
40  BF FF                BII  A,&FF          ; A = 0 -> wyslano 8 bitow
42  99 17                BZR- OUT
44  38                   NOP                 ; (wyrownanie ostatniego bitu danych)
45  38                   NOP
46  F9                   REC
47  FD 5B 80             ORI  #(Y),&80       ; bit stopu (PC7 = 1)
4A  6A 0A                LDI  UL,10          ; dlugosc bitu stopu (~1,2 bitu)
4C  88 02        TDLY:   LOP  UL,TDLY
4E  FD 62                DEC  UH
50  99 30                BZR- CHAR           ; nastepny znak
52  F9                   REC                 ; C=0: zmienna N bez zmian
53  9A                   RTN
