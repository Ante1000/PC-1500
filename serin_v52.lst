; SERIN v52 - listing (adresy wzgledem SI = RAM+&22A), 121 bajtow
;
                 ; =====================================================================
                 ; SERIN v52 - programowy odbiornik UART 4800 bps 8N1 dla Sharp PC-1500(A)
                 ; CPU LH5801 @ 1,3 MHz, wejscie PB2 (CMT-IN, pin 27 zlacza 60-pin),
                 ; polaryzacja TTL-232 (spoczynek = 1, bit startu = 0).
                 ;
                 ; Wywolanie z BASIC-a:
                 ;   CALL SI          odbierz do 127 znakow
                 ;   CALL SI,M        odbierz najwyzej M znakow (1..127; 0 lub >127 = 127)
                 ; Wynik:
                 ;   RX+0             liczba odebranych znakow (0 = nic nie przyszlo)
                 ;   RX+1..RX+127     odebrane znaki
                 ;   M                (tylko przy CALL SI,M) = liczba odebranych znakow
                 ;                    (powrot z C=1 -> ROM wpisuje X do zmiennej z CALL)
                 ; Czas:
                 ;   pierwszy znak musi przyjsc w ciagu ~30 s, kolejne w odstepach < ~0,5 s,
                 ;   po M-tym (lub 127.) znaku powrot natychmiast.
                 ;
                 ; Adres ladowania: SI = RAM+&22A (&422A), 121 bajtow (&422A..&42A2).
                 ; Symbole wstawiane przez BASIC: RH/RL = adres RX, R1 = RL+1, CN = 255-RL.
                 ; Skoki: LH5801 ma osobne kody dla skokow w przod (+) i w tyl (-),
                 ; przesuniecie jest ZAWSZE dodatnie (0..255), liczone od nastepnego rozkazu.
                 ; Petla bitu jest bajt w bajt taka jak w sprawdzonym SERIN v47.
                 ; Plik jest zrodlem dla tools/build_serin.py (asembler + generator POKE).
                 ; =====================================================================
00  FD BE                RIE                 ; bez przerwan (timing!)
02  84                   LDA  XH             ; CALL SI bez zmiennej: X = adres w ROM (XH<>0)
03  89 07                BZR+ MAXM           ;   -> m = 127
05  04                   LDA  XL             ; CALL SI,M: X = M
06  8B 04                BZS+ MAXM           ; M = 0 -> m = 127
08  BF 80                BII  A,&80          ; M >= 128 ?
0A  8B 02                BZS+ SETM           ; 1..127 -> zostaw
0C  B5 7F        MAXM:   LDI  A,&7F          ; m = 127 (caly bufor)
0E  AE RH RL     SETM:   STA  (RX)           ; RX[0] = licznik pozostalych znakow (m)
11  48 RH                LDI  XH,RH          ; X = RX+1 (pierwszy bajt danych)
13  4A R1                LDI  XL,R1
15  58 F0                LDI  YH,&F0         ; Y = &F00D (DDB, rejestr kierunku portu B)
17  5A 0D                LDI  YL,&0D
19  FD 59 FB             ANI  #(Y),&FB       ; PB2 = wejscie
1C  54                   INC  Y
1D  54                   INC  Y              ; Y = &F00F (port B, bit 2 = CMT-IN)
1E  68 00                LDI  UH,&00         ; timeout 1. znaku: 18*256*256 obiegow ~ 30 s
20  B5 12                LDI  A,18
22  FD 5D 04     WH:     BII  #(Y),&04       ; czekaj na stan spoczynkowy (1 = mark)
25  89 0B                BZR+ WL             ; linia = 1 -> czekaj na bit startu
27  88 07                LOP  UL,WH          ; 256 obiegow x 33 cykle
29  FD 62                DEC  UH
2B  99 0B                BZR- WH
2D  DF                   DEC  A
2E  99 0E                BZR- WH
30  8E 3B                BCH+ DONE           ; timeout
32  FD 5D 04     WL:     BII  #(Y),&04       ; czekaj na zbocze 1->0 (bit startu)
35  8B 0B                BZS+ START
37  88 07                LOP  UL,WL
39  FD 62                DEC  UH
3B  99 0B                BZR- WL
3D  DF                   DEC  A
3E  99 0E                BZR- WL
40  8E 2B                BCH+ DONE           ; timeout
42  6A 07        START:  LDI  UL,7           ; ~pol bitu (ten sam czas do 1. probki co v47)
44  88 02        HALF:   LOP  UL,HALF
46  FD 5D 04             BII  #(Y),&04       ; srodek bitu startu: nadal 0?
49  99 19                BZR- WL             ; nie -> zaklocenie, czekaj dalej
4B  68 08                LDI  UH,8           ; 8 bitow danych
4D  6A 13        BIT:    LDI  UL,&13         ; petla bitu IDENTYCZNA jak w v47
4F  88 02        DLY:    LOP  UL,DLY
51  FD 5D 04             BII  #(Y),&04
54  FB                   SEC
55  89 01                BZR+ ONE
57  F9                   REC
58  D1           ONE:    ROR                 ; LSB pierwszy
59  FD 62                DEC  UH
5B  99 10                BZR- BIT
5D  41                   SIN  X              ; zapisz znak, X++
5E  A5 RH RL             LDA  (RX)           ; pozostalo--
61  DF                   DEC  A
62  8B 09                BZS+ DONE           ; odebrano m znakow -> koniec
64  AE RH RL             STA  (RX)
67  68 4D                LDI  UH,77          ; timeout miedzy znakami: 77*256 obiegow ~ 0,5 s
69  B5 01                LDI  A,1
6B  9E 4B                BCH- WH             ; czekaj na bit stopu i kolejny znak
6D  04           DONE:   LDA  XL             ; liczba znakow = XL - (RL+1)
6E  F9                   REC
6F  B3 CN                ADI  A,CN           ; CN = 255-RL
71  AE RH RL             STA  (RX)           ; RX[0] = liczba odebranych znakow
74  0A                   STA  XL             ; X = liczba znakow ...
75  48 00                LDI  XH,0
77  FB                   SEC                 ; ... C=1: BASIC wpisze X do zmiennej z CALL SI,M
78  9A                   RTN
